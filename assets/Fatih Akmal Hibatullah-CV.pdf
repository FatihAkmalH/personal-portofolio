  <pdf:Keywords>Data Input &amp; Data Monitoring, HTML, CSS, JavaScript (Dasar), Content Writing &amp; SEO, Nielsen Arianna (TV Program Analysis), Microsoft Excel (Pivot Table, Macro, Data Cleaning)</pdf:Keywords>
 </rdf:Description>

 <rdf:Description rdf:about=''
  xmlns:rms='https://github.com/rezi-io/resume-standard'>
  <rms:producer>rms_v2.0.1</rms:producer>
